DATABASE_URL="postgresql://postgres:change-me@localhost:5432/ohm_flow?schema=public"
SESSION_SECRET="replace-with-at-least-32-random-characters"
WEB_ORIGIN="http://localhost:3000"
API_PORT=4000
NODE_ENV=development
# Mettre "true" uniquement derriere un reverse proxy de confiance (X-Forwarded-For)
TRUST_PROXY=false
# Swagger (/docs) est desactive en production sauf si "true"
ENABLE_API_DOCS=false
