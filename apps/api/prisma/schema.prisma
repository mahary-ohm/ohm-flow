generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  USER
  AGENT
}

enum TicketStatus {
  OPEN
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

model User {
  id                  String                   @id @default(cuid())
  firstName           String
  lastName            String
  email               String                   @unique
  passwordHash        String
  role                Role                     @default(USER)
  isActive            Boolean                  @default(true)
  cellId              String?
  cell                Cell?                    @relation("UserCell", fields: [cellId], references: [id], onDelete: Restrict)
  agentCells          AgentCell[]
  createdTickets      Ticket[]                 @relation("TicketCreator")
  assignedTickets     Ticket[]                 @relation("TicketAssignee")
  statusChanges       TicketStatusHistory[]
  assignments         TicketAssignmentHistory[]
  comments            TicketComment[]
  sessions            Session[]
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  @@index([role, isActive])
  @@index([cellId, isActive])
}

model Service {
  id          String   @id @default(cuid())
  name        String   @unique
  description String?
  isActive    Boolean  @default(true)
  cells       Cell[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Cell {
  id          String   @id @default(cuid())
  name        String
  description String?
  isActive    Boolean  @default(true)
  serviceId   String
  service     Service  @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  users       User[]   @relation("UserCell")
  agents      AgentCell[]
  tickets     Ticket[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([serviceId, name])
  @@index([serviceId, isActive])
}

model AgentCell {
  agentId   String
  cellId    String
  agent     User     @relation(fields: [agentId], references: [id], onDelete: Cascade)
  cell      Cell     @relation(fields: [cellId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  @@id([agentId, cellId])
  @@index([cellId])
}

model Ticket {
  id              String      @id @default(cuid())
  reference       String      @unique
  title           String
  description     String
  status          TicketStatus @default(OPEN)
  cellId          String
  cell            Cell        @relation(fields: [cellId], references: [id], onDelete: Restrict)
  creatorId       String
  creator         User        @relation("TicketCreator", fields: [creatorId], references: [id], onDelete: Restrict)
  assigneeId      String?
  assignee        User?       @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: Restrict)
  resolvedAt      DateTime?
  version         Int         @default(1)
  statusHistory   TicketStatusHistory[]
  assignmentHistory TicketAssignmentHistory[]
  comments        TicketComment[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([cellId, status, createdAt])
  @@index([assigneeId, status])
  @@index([status, createdAt])
}

model TicketReferenceCounter {
  year Int @id
  next Int @default(0)
}

model TicketStatusHistory {
  id        String       @id @default(cuid())
  ticketId  String
  ticket    Ticket       @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User         @relation(fields: [actorId], references: [id], onDelete: Restrict)
  from      TicketStatus?
  to        TicketStatus
  comment   String?
  createdAt DateTime     @default(now())

  @@index([ticketId, createdAt])
}

model TicketAssignmentHistory {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User     @relation(fields: [actorId], references: [id], onDelete: Restrict)
  fromId    String?
  toId      String?
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model TicketComment {
  id        String   @id @default(cuid())
  ticketId  String
  ticket    Ticket   @relation(fields: [ticketId], references: [id], onDelete: Restrict)
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Restrict)
  content   String
  createdAt DateTime @default(now())

  @@index([ticketId, createdAt])
}

model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  data      Json
  expiresAt DateTime

  @@index([expiresAt])
  @@index([userId])
}
