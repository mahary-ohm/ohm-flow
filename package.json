{
  "name": "ohmflow",
  "version": "1.0.0",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @ohmflow/api --filter @ohmflow/web dev",
    "build": "pnpm -r build",
    "test": "pnpm --filter @ohmflow/api test",
    "db:generate": "pnpm --filter @ohmflow/api db:generate",
    "db:migrate": "pnpm --filter @ohmflow/api db:migrate",
    "db:seed-admin": "pnpm --filter @ohmflow/api db:seed-admin"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
